# Datamart Warmup settings, merged into the server's .env on top of
# .env.example. No secrets here: the secrets block at the top of .env.example
# is generated on the server and never committed.

# Release. Bump after the weekly review, once Datamart images has built it.
WARMBLY_IMAGE_PREFIX=ghcr.io/warmbly/warmbly
WARMBLY_TAG=v0.6.78

# Addresses. One level under dtm.global so Cloudflare's free certificate covers them.
APP_URL=https://warmup.dtm.global
API_PUBLIC_URL=https://warmup-api.dtm.global
CORS_ALLOW_ORIGINS=https://warmup.dtm.global,https://warmup-admin.dtm.global
WEBSOCKET_URL=wss://warmup-ws.dtm.global/socket/websocket
PHX_HOST=warmup-ws.dtm.global
TRACKING_DOMAIN=warmup-t.dtm.global

# Sign-up is open: anyone with the link creates their own workspace, which is
# what keeps each company's mailboxes warming other companies' mailboxes.
# Never invite another company into an existing workspace.
DISABLE_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=true

# Platform email (sign-in, invites, alerts) through Amazon SES, using the
# server's IAM role, so no keys sit on the box.
MAIL_TRANSPORT=ses
AWS_REGION=us-east-1
EMAIL_NAME=Datamart Warmup
EMAIL_ADDRESS=noreply@mail.dtm.global
NOTIFICATION_EMAIL_DAILY_CAP=10

EMAIL_BRAND_NAME=Datamart Warmup
EMAIL_BRAND_LEGAL_ENTITY=Datamart Inc.
EMAIL_BRAND_WEBSITE_URL=https://warmup.dtm.global
EMAIL_BRAND_SUPPORT_EMAIL=

# Molty, the AI assistant: Claude on Amazon Bedrock through the LiteLLM bridge
# (datamart/deploy/litellm.yaml). AI_API_KEY is the bridge's key, generated on
# the server. Allowance per workspace in credits (one Molty step, one AI
# email line): free per UTC day, or per month for the unlocked list.
AI_PROVIDER=custom
AI_BASE_URL=http://litellm:4000/v1
AI_MODEL=molty
DATAMART_AI_FREE_DAILY=15
DATAMART_AI_UNLOCKED_MONTHLY=1500
DATAMART_AI_UNLOCKED_ORGS=
# Per-workspace monthly allowance, overriding the above: "<org id>=2500,...".
DATAMART_AI_ORG_MONTHLY=

# Updates are reviewed and rolled out by hand, not by the in-app updater.
UPDATE_CHECK_ENABLED=false

# Uploaded files (attachments, imports, avatars, logos) live in a private S3
# bucket, reached with the server's IAM role. Downloads stream through the API,
# so no browser ever talks to the bucket; public images go through /public.
BLOB_PROVIDER=s3
BLOB_BUCKET=datamart-warmup-files-066523632153
BLOB_PUBLIC_BASE_URL=https://warmup-api.dtm.global/public
CAMPAIGN_ATTACHMENT_DOWNLOAD_PROXY=true
